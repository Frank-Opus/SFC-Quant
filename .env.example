APP_ENV=development
APP_MODE=mock
LIVE_TRADING_ENABLED=false

AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-5.4
AI_TIMEOUT_SECONDS=30
FINNHUB_API_KEY=
FRED_API_KEY=
EIA_API_KEY=
COINGECKO_API_KEY=
EXTERNAL_INTEL_CACHE_TTL_SECONDS=300
EXTERNAL_INTEL_NEWS_LIMIT=5

BACKEND_EXTRAS=
STRATEGY_FACTORY_ENABLED=false
STRATEGY_FACTORY_PROVIDER=mock_rdq
STRATEGY_FACTORY_WORKSPACE=./var/strategy_factory
STRATEGY_FACTORY_AUTO_GENERATE=false
# Recommended local RD-Agent shim when using the dedicated `.runtime-venv`:
# STRATEGY_FACTORY_RD_AGENT_COMMAND=./.runtime-venv/bin/python backend/scripts/run_rdagent.py fin_quant
STRATEGY_FACTORY_RD_AGENT_COMMAND=rdagent fin_quant
STRATEGY_FACTORY_RD_AGENT_TIMEOUT_SECONDS=900
# Recommended local TradingAgents-CN CLI shim for callable validation:
# STRATEGY_FACTORY_TRADINGAGENTS_COMMAND=./.runtime-venv/bin/python backend/scripts/run_tradingagents.py help
STRATEGY_FACTORY_TRADINGAGENTS_COMMAND=tradingagents
STRATEGY_FACTORY_TRADINGAGENTS_TIMEOUT_SECONDS=900
DOCKER_HOST=

EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
MARKET_DATA_MODE=real

EXECUTION_MODE=paper
EXECUTION_ADAPTER=freqtrade_mock
# Freqtrade REST API host; enable `api_server.enabled` and `dry_run=true` on this service before pointing here.
EXECUTION_FREQTRADE_REST_BASE_URL=
EXECUTION_FREQTRADE_REST_USERNAME=
EXECUTION_FREQTRADE_REST_PASSWORD=
EXECUTION_FREQTRADE_REST_TIMEOUT_SECONDS=10
EXECUTION_FREQTRADE_REST_ORDER_TYPE=market
EXECUTION_ENGINE_START_PAUSED=false
EXECUTION_PAPER_STARTING_BALANCE=10000
EXECUTION_ORDER_NOTIONAL_USD=500
EXECUTION_FEE_RATE=0.001
EXECUTION_MAX_RECENT_ORDERS=50

RISK_MAX_POSITION_NOTIONAL_USD=1000
RISK_MAX_CONCURRENT_TRADES=3
RISK_DAILY_LOSS_LIMIT_USD=250
RISK_BLOCKED_SYMBOLS=
RISK_REQUIRE_AGENT_APPROVAL=true
RISK_MIN_APPROVAL_CONFIDENCE=0.55

FRONTEND_API_URL=http://backend:8000
FRONTEND_WS_URL=ws://backend:8000/ws
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
CORS_ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\\.0\\.0\\.1)(:\\d+)?$

MARKET_SYMBOLS=BTC/USDT,ETH/USDT
MARKET_TIMEFRAMES=1m,5m
MARKET_HISTORY_LIMIT=24
MARKET_POLL_INTERVAL_SECONDS=3
MARKET_EVENT_BUFFER_SIZE=100
MARKET_STREAM_ENABLED=true
EVENT_LOG_DIR=./var/events
